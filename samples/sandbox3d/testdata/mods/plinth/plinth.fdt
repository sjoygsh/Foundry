# Geometry is generated by scripts/m25/make_props.py. The material has an authored ID,
# so another content package can override its look without replacing the geometry.
foundry:material plinth:materials.stone {
    shading foundry:shading.lit
    base_color { r 0.42 g 0.38 b 0.32 a 1 }
    roughness 0.9
}
foundry:model_import plinth:models.plinth {
    source "models/plinth.gltf"
    collision true
    materials [ { name "Stone" material plinth:materials.stone } ]
}
sandbox3d:prop plinth:props.main {
    model plinth:models.plinth
    position { x -2.2 y 0 z 1.6 }
    collision plinth:models.plinth.collision
}

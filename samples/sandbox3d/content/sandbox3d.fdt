# The 3D sandbox's content package (`docs/design/render3d.md` §8, `docs/design/meshes.md` §9).
#
# Since M20 the scene is content: `models/room.gltf` and `models/crate.gltf`, written by
# `scripts/m20/make_scene.py` and imported by the package compiler into `foundry:model`,
# `foundry:mesh`, `foundry:material` and `foundry:texture` records. The spinning cube on the
# table is still built by the sample, with a material made in code, so the code path and the
# content path are seen drawing the same way. What the sample is told -- its window, its clear
# colour, its models and how the camera moves -- is here, and a package loaded after this one
# changes any of it without a rebuild.
#
# Since M21 the objects on the table are entities (`docs/design/hierarchy.md` §8): each is a
# template below, with its `foundry:transform`, the model it draws and how it spins. The sample
# spawns them and sets their parents in code, because a parent is an entity and content never
# names one.

# The room's import, written only because one default is wrong for it: its glass should be a
# material someone can find by name and edit, rather than `sandbox3d:models.room.material6`.
foundry:model_import sandbox3d:models.room {
    source    "models/room.gltf"
    collision true
    collision_exclude [ "Plant" ]
    materials [ { name "Glass"  material sandbox3d:materials.glass } ]
}

foundry:model_import sandbox3d:models.course {
    source "models/course.gltf"
    collision true
}

# M24: generated by scripts/m24/make_character.py; ordinary imported assets.
foundry:model_import sandbox3d:models.walker { source "models/walker.gltf" }
@schema walker {
    model id
    waypoints [{ x f32 y f32 z f32 }]
    speed f32
    cross_fade f32
}

# M25: Tier 1 packages add props; the base package deliberately adds none.
# Collision poses are rigid (ADR-0057): bake size at import and keep scale 1 when solid.
@schema prop {
    model id
    position { x f32 y f32 z f32 }
    yaw f32 (default 0)
    scale f32 (default 1)
    collision id (optional)
}
walker sandbox3d:walker.main {
    model sandbox3d:models.walker
    waypoints [ { x 1.0 y 0.004 z 2.2 } { x 1.0 y 0.004 z 0.2 }
                { x 2.3 y 0.004 z 0.2 } { x 2.3 y 0.004 z 2.2 } ]
    speed 0.6
    cross_fade 0.25
}

# M23's independent record: lighting-only whole-record overrides still walk.
@schema walk {
    start_camera string (default "walk")
    spawn { x f32 y f32 z f32 }
    spawn_yaw f32 (default 0)
    radius f32 height f32 eye_height f32
    max_slope f32 step_height f32 snap_distance f32
    walk_speed f32 gravity f32 turn_rate f32 look_rate f32
    course id
    collision [id]
}

walk sandbox3d:walk.main {
    spawn { x 1.1 y 0.004 z 2.5 }
    radius 0.3 height 1.8 eye_height 1.65
    max_slope 0.785398 step_height 0.35 snap_distance 0.3
    walk_speed 3 gravity 9.81 turn_rate 1.5 look_rate 0.004
    course sandbox3d:models.course
    collision [ sandbox3d:models.room.collision sandbox3d:models.course.collision ]
}

foundry:material sandbox3d:materials.glass {
    shading      foundry:shading.lit
    roughness    0.15
    base_color   { r 0.55  g 0.75  b 0.85  a 0.35 }
    alpha_mode   "blend"
    double_sided true
}

# One crate in the grid draws with this in place of its own material: a slot override, for one
# draw, on a model every other crate shares.
foundry:material sandbox3d:materials.crate_painted {
    shading            foundry:shading.lit
    roughness          0.65
    base_color         { r 0.35  g 0.55  b 1.0  a 1.0 }
    base_color_texture sandbox3d:models.crate.texture0
}

@schema config {
    # The window, in logical points. The window exists before content loads, so the sample
    # applies these once this record has been read.
    title  string (default "")
    width  u32 (default 1280)
    height u32 (default 720)

    # Linear RGBA, as every colour the renderer takes is (ADR-0048). The surface is sRGB and
    # encodes it.
    clear_linear [f32]

    # The camera circles the room's centre at this rate, radius and height, looking at the
    # table. Radians per second and metres (ADR-0048).
    orbit_radians_per_second f32 (default 0.15)
    orbit_radius f32 (default 7.5)
    orbit_height f32 (default 5.0)

    # What is drawn. `crate_override` replaces the crate's one slot for one crate of the grid.
    room id
    crate id
    crate_override id

    # A square grid of crates, `crate_grid` to a side and `crate_spacing` metres apart, centred
    # on the room. A cell within `crate_clearance` metres of the centre on both axes would stand
    # inside the walls, and is left empty.
    crate_grid u32 (default 9)
    crate_spacing f32 (default 2.4)
    crate_clearance f32 (default 3.5)

    # From `foundry:core`: a cross-package reference is an ordinary id.
    font id

    # Photometric units (ADR-0056): EV100, cd/m² ambient; lux for directional,
    # candela for point/spot. Direction is the light's local −Z, not Euler angles.
    exposure_ev100 f32 (default 6)
    ambient { r f32 (default 8) g f32 (default 8) b f32 (default 8) }
    lights [{
        kind string
        color { r f32 (default 1) g f32 (default 1) b f32 (default 1) }
        intensity f32
        range f32 (default 0)
        inner_cone f32 (default 0)
        outer_cone f32 (default 0.785398)
        casts_shadow bool (default false)
        position { x f32 y f32 z f32 }
        direction { x f32 (default -1) y f32 (default -2) z f32 (default -1) }
    }]
}

config sandbox3d:config.main {
    title  "Foundry Sandbox 3D"
    width  1280
    height 720
    clear_linear [ 0.010 0.012 0.018 1.0 ]
    orbit_radians_per_second 0.15
    orbit_radius 4.0
    orbit_height 2.4
    room sandbox3d:models.room
    crate sandbox3d:models.crate
    crate_override sandbox3d:materials.crate_painted
    crate_grid 9
    crate_spacing 2.4
    font foundry:fonts.debug
    exposure_ev100 6
    ambient { r 8 g 10 b 14 }
    lights [
        { kind "directional" intensity 700 color { r 1 g 0.94 b 0.8 }
          position { x 0 y 0 z 0 } direction { x -1 y -2 z -1 } casts_shadow true }
        { kind "point" intensity 120 range 8 position { x -1.5 y 2 z 1.5 }
          color { r 1 g 0.72 b 0.45 } direction { x -1 y -2 z -1 } }
        { kind "point" intensity 80 range 8 position { x 1.5 y 2 z -1.5 }
          color { r 0.5 g 0.7 b 1 } direction { x -1 y -2 z -1 } }
    ]
}

# -- M21: nested moving objects ---------------------------------------------------------
#
# The sample's two component types, declared here so a template can carry them. The names and
# types match the Zig structs in `orrery.zig` field for field, which `World.spawn` checks.

# The model an entity draws, by content ID.
@schema model { model id }

# A turn about the entity's own axis, in radians per second. A child turns with it.
@schema spin {
    axis { x f32  y f32  z f32 }
    rate f32
}

# Poses are local, in metres (ADR-0048): a child's is in its parent's frame, scale included.
# The table's top is at 0.78 m. The crate model is 0.8 m tall, standing on its origin.

# The turntable: a pivot that turns, carrying a flat platter and a riding crate. Both are its
# children rather than one the other's, because a child of the flattened platter would be
# flattened too.
foundry:transform sandbox3d:orrery.turntable.pose { translation { x -0.4  y 0.78  z 0.0 } }
spin sandbox3d:orrery.turntable.spin { axis { x 0  y 1  z 0 }  rate 0.5 }
foundry:entity sandbox3d:entity.turntable {
    components [ sandbox3d:orrery.turntable.pose  sandbox3d:orrery.turntable.spin ]
}

foundry:transform sandbox3d:orrery.platter.pose { scale { x 0.7  y 0.05  z 0.7 } }
model sandbox3d:orrery.platter.model { model sandbox3d:models.crate }
foundry:entity sandbox3d:entity.platter {
    components [ sandbox3d:orrery.platter.pose  sandbox3d:orrery.platter.model ]
}

# Rides the platter a little off centre, and turns about its own axis.
foundry:transform sandbox3d:orrery.rider.pose {
    translation { x 0.18  y 0.04  z 0.0 }
    scale       { x 0.25  y 0.25  z 0.25 }
}
model sandbox3d:orrery.rider.model { model sandbox3d:models.crate }
spin sandbox3d:orrery.rider.spin { axis { x 0  y 1  z 0 }  rate 1.2 }
foundry:entity sandbox3d:entity.rider {
    components [ sandbox3d:orrery.rider.pose  sandbox3d:orrery.rider.model  sandbox3d:orrery.rider.spin ]
}

# The rider's child, so it orbits the rider without a spin of its own. Its translation is in
# the rider's scaled frame: 1.1 of the rider's units is 0.275 m.
foundry:transform sandbox3d:orrery.moon.pose {
    translation { x 1.1  y 0.9  z 0.0 }
    scale       { x 0.35  y 0.35  z 0.35 }
}
model sandbox3d:orrery.moon.model { model sandbox3d:models.crate }
foundry:entity sandbox3d:entity.moon {
    components [ sandbox3d:orrery.moon.pose  sandbox3d:orrery.moon.model ]
}

# `3d.md` §7.1's example: a frame scaled (2, 1, 1) with a child turned 45° on top of it. The
# child's world is sheared, a rhombus seen from above, and it is drawn that way.
foundry:transform sandbox3d:orrery.frame.pose {
    translation { x 0.45  y 0.78  z 0.0 }
    scale       { x 0.4  y 0.2  z 0.2 }
}
model sandbox3d:orrery.frame.model { model sandbox3d:models.crate }
foundry:entity sandbox3d:entity.frame {
    components [ sandbox3d:orrery.frame.pose  sandbox3d:orrery.frame.model ]
}

foundry:transform sandbox3d:orrery.sheared.pose {
    translation { x 0.0  y 0.8  z 0.0 }
    rotation    { x 0.0  y 0.38268343  z 0.0  w 0.92387953 }
}
model sandbox3d:orrery.sheared.model { model sandbox3d:models.crate }
foundry:entity sandbox3d:entity.sheared {
    components [ sandbox3d:orrery.sheared.pose  sandbox3d:orrery.sheared.model ]
}

# M19's cube, a mesh the sample builds in code, so it has a pose and a spin and no model.
foundry:transform sandbox3d:orrery.cube.pose {
    translation { x 0.05  y 1.2  z -0.2 }
    scale       { x 0.25  y 0.25  z 0.25 }
}
spin sandbox3d:orrery.cube.spin { axis { x 0.3  y 1  z 0.2 }  rate 0.6 }
foundry:entity sandbox3d:entity.cube {
    components [ sandbox3d:orrery.cube.pose  sandbox3d:orrery.cube.spin ]
}

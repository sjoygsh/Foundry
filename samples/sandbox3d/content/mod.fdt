# The 3D sandbox's manifest.
#
# It needs `foundry:core` for the debug font its overlay line is drawn in, and says so.

foundry:mod  sandbox3d:content {
    name     "Sandbox 3D"
    version  1
    license  "Apache-2.0"
    summary  "A room imported from glTF, a grid of crates around it, and one line of text over them."
    requires [ { id foundry:core } ]
}

# The room's content package.
#
# **Everything the sample is** is in this file and the four it points at. There is no
# level in the source, no item table, no tuning constant: the map, the art, the sounds,
# where the lamps stand, how fast the walker walks and what the sign over the rug says are
# all content, and a package loaded after this one changes any of them without a rebuild.
#
# That is not a demonstration of the content system -- `samples/sandbox` is that. It is
# what a game looks like when the content system is doing its job, which is the thing M5's
# exit criterion actually asks for.

# ---------------------------------------------------------------------------------------
# What the room is made of.

@schema settings {
    # The two textures, by content id. The sample names no path and no file and could not
    # ask for one if it wanted to (ADR-0021).
    sheet id
    # From `foundry:core`, not from here. A cross-package reference is an ordinary id.
    font  id
    # Where the font's texture keeps solid white, as [x y width height] in its texels, so the
    # UI's rectangles and its text come from one texture and share a batch. Omitted, or not
    # inside the texture, the renderer's own blank is used -- which is right for a font without
    # such a patch. A package replacing the font must keep this true or say otherwise here.
    font_solid [u32] (since 2) (optional)
    map   id
    # The sheet is a square grid; these are its dimensions in cells.
    columns u32 (default 4)
    rows    u32 (default 4)

    # Where the walker starts, as a **column and a row of the map as written** -- row 0 is
    # the first row of `hall.grid`, the one at the top of the screen. Author coordinates,
    # not world coordinates: the person placing this is looking at the grid file, and
    # asking them to convert to a Y-up world whose origin is the middle of the map would be
    # asking them to do arithmetic the sample can do once and correctly.
    start [u32]

    # How far in the camera sits. The map is deliberately larger than the window at this
    # zoom, so the camera has to follow.
    zoom f32 (default 3)

    # The walker's box, in world units, and how fast it moves, in world units per second.
    # Both are *feel*, and feel is the game's -- which is why `physics2d` has no speed
    # anywhere in it (ADR-0022: collision, not dynamics).
    player_size  f32 (default 11)
    player_speed f32 (default 74)
    player_walk id
    player_idle id

    step_sound  id
    bump_sound  id
    chime_sound id
    open_sound  id
    # The door's own note, looping, panned by where the walker is standing relative to it.
    # It stops when the door does.
    hum_sound   id

    # What the room says. Three strings, because a game that says nothing is a demo with a
    # character in it -- and because a translated package is then a package, not a patch.
    title string (default "")
    hint  string (default "")
    won   string (default "")
    # Completed by the sample as "3 of 6 <lamp_label>". A format string in content would be
    # a way for a package to crash the game, so content supplies the noun and the sample
    # supplies the shape.
    lamp_label string (default "lamps lit")

    # The card the walker opens over the hall, with tab. Five more strings for the same
    # reason as the three above: a translated package is a package rather than a patch,
    # and a card whose words were in the source would be the one thing in this sample that
    # a mod could not change.
    card_title   string (default "")
    name_label   string (default "")
    volume_label string (default "")
    close_label  string (default "")
    # What the walker is called before anyone renames them. Drawn over their head, and
    # what the card's name field starts out holding.
    walker_name  string (default "")
}

# An animation clip: a run of cells from a sheet, and how long each is held.
#
# **The second sample to define this schema, independently, and that is the finding.** The
# engine still owns no `foundry:clip` (`sprite-animation.md` §5): a schema name is a
# compatibility decision and M7 is when the mod-facing vocabulary gets chosen. Two samples
# arriving at the same seven fields is the evidence that argument was waiting for.
# How the application presents itself, as ordinary content.
#
# **Separate from `settings` above, and deliberately.** That one is what the room *is* --
# its map, its art, how fast the walker walks. This is what the *application* does with the
# window and the speakers, and the difference matters because these three are the only
# fields a player can overrule from their own preferences file. A package loaded after this
# one may change any of them; a package may not decide where preferences are kept, which
# packages load, or whether native code runs (ADR-0031).
#
# Every field is optional. A package that says nothing here leaves the sample on the values
# it was built with.
@schema config {
    # Logical units, not pixels -- the size a window manager is asked for, before any
    # display scaling. The sample refuses anything outside 320..8192.
    window_width  u32 (default 1280)
    window_height u32 (default 720)
    # Everything the mixer plays, scaled by this. 0..1.
    master_volume f32 (default 1)
    # The image the window wears, of the `icon` kind below. Without one the window system's
    # own default stands: the engine has no mark to supply (`vulkan.md` §9).
    window_icon id (since 2) (optional)
}

@schema clip {
    sheet   id
    columns u32
    rows    u32
    first u32 (default 0)
    count u32
    hold  u32 (default 6)
    loops bool (default true)
}

# A lamp. Walk into it and it lights.
#
# The whole of it is a place and two clips. Nothing here says what lighting one *does* --
# that is the sample counting, and counting six of something is not a thing content should
# have to describe.
@schema lamp {
    at [u32]
    dark id
    lit  id
    # How close counts, in world units, measured from the walker's centre. Content, because
    # "how close is close" is feel.
    radius f32 (default 11)
}

# The door in the north wall. Content says where it is and what it looks like; the sample
# says it goes away when every lamp is lit.
#
# **It is an entity and not a tile**, and the reason is the whole of why this sample has a
# `scene` at all: a tile is a number in a grid two other subsystems are reading, and a door
# has to be able to stop existing. Despawning an entity removes its sprite from the draw
# list and its body from the collision world in one call, and neither the map nor the
# tileset has to know a door was ever there.
@schema door {
    # Column and row of its **top-left** cell, as written, and how many cells it covers.
    at   [u32]
    span [u32]
    clip id
}

# The way out. Standing on it ends the sample.
@schema way_out {
    at   [u32]
    span [u32]
}

# ---------------------------------------------------------------------------------------
# What the room is.

settings room:settings.main {
    sheet   room:textures.room
    font    foundry:fonts.debug
    # The inside of the debug font's 96th cell, which holds no glyph and is solid white.
    font_solid [ 122 42 4 4 ]
    map     room:map.hall
    columns 4
    rows    4

    # On the rug, in the middle of the hall.
    start   [ 15 15 ]
    zoom    3

    # Narrower than the 16-unit cells, so a two-cell doorway is comfortably a doorway.
    player_size  11
    player_speed 74
    player_walk  room:clip.walk
    player_idle  room:clip.idle

    # **No records declare these.** A `.wav` in the package becomes a `foundry:sound` from
    # its own path, exactly as the `.png` becomes a `foundry:texture` -- `sounds/step.wav`
    # in package `room` is `room:sounds.step`. Naming them here is the only place the
    # sample says anything about them at all.
    step_sound   room:sounds.step
    bump_sound   room:sounds.bump
    chime_sound  room:sounds.chime
    open_sound   room:sounds.open
    hum_sound    room:sounds.hum

    title "the long hall"
    hint  "wasd walks. click to go. tab opens the card"
    won   "the hall is lit.\nthe way out is open."
    lamp_label "lamps lit"

    card_title   "the walker"
    name_label   "name"
    volume_label "volume"
    close_label  "close"
    walker_name  "the lamplighter"
}

# The sheet's first row is the tileset and the rest is everything drawn as a sprite, which
# is why one texture serves both and there is only one to load.

# ---------------------------------------------------------------------------------------
# How the room's screens look (M14, ADR-0041).
#
# A `foundry:ui_theme`: the card's colours and sizes, and the atlas the game widget set draws
# its patches and icons from -- `textures/ui.png`, which `scripts/gen-room-assets.py` draws.
# A package loaded after this one re-skins every screen by overriding this one record, and a
# theme that cannot be used leaves the card as it looked before themes were content.
# Colours are sRGB, 0xRRGGBBAA.
foundry:ui_theme room:ui.theme {
    atlas       room:textures.ui
    font        { texture foundry:fonts.debug  cell_w 8  cell_h 8  columns 16  count 95 }
    text_scale  1.5
    line_height 20
    padding_x   10
    # Four, not more: a checkbox and a reorder grip are a line less this padding twice.
    padding_y   4
    spacing     5
    separator   1
    # The atlas's four-pixel borders, drawn at twice their size.
    patch_scale 2
    colors {
        text     0xffe2b4f0   text_dim    0x96826ec8   surface        0x0a0806e1
        control  0x2e261eeb   control_hot 0x4a3c2cf5   control_active 0x6e583cff
        accent   0xffbe6eff
        positive 0x7ccf7cff   negative    0xe06a5aff   warning        0xf0c050ff
        selection 0xffbe6e46
    }
    patches [
        { part "panel"           x 0   y 0   w 12  h 12  left 4  top 4  right 4  bottom 4 }
        { part "button"          x 12  y 0   w 12  h 12  left 4  top 4  right 4  bottom 4 }
        { part "button_hot"      x 24  y 0   w 12  h 12  left 4  top 4  right 4  bottom 4 }
        { part "button_active"   x 36  y 0   w 12  h 12  left 4  top 4  right 4  bottom 4 }
        { part "button_disabled" x 48  y 0   w 12  h 12  left 4  top 4  right 4  bottom 4 }
        { part "field"           x 0   y 12  w 12  h 12  left 4  top 4  right 4  bottom 4 }
        { part "check_off"       x 12  y 12  w 12  h 12  left 4  top 4  right 4  bottom 4 }
        { part "check_on"        x 24  y 12  w 12  h 12  left 4  top 4  right 4  bottom 4 }
        { part "row"             x 36  y 12  w 12  h 12  left 4  top 4  right 4  bottom 4 }
        { part "row_selected"    x 48  y 12  w 12  h 12  left 4  top 4  right 4  bottom 4 }
        { part "tab"             x 0   y 24  w 12  h 12  left 4  top 4  right 4  bottom 4 }
        { part "tab_on"          x 12  y 24  w 12  h 12  left 4  top 4  right 4  bottom 4 }
        { part "scroll_track"    x 24  y 24  w 12  h 12  left 4  top 4  right 4  bottom 4 }
        { part "scroll_thumb"    x 36  y 24  w 12  h 12  left 4  top 4  right 4  bottom 4 }
    ]
    # The mod screen's icons, by the room's own names for them.
    icons [
        { name "native"    x 0   y 36  w 8  h 8 }
        { name "script"    x 8   y 36  w 8  h 8 }
        { name "win"       x 16  y 36  w 8  h 8 }
        { name "lose"      x 24  y 36  w 8  h 8 }
        { name "both"      x 32  y 36  w 8  h 8 }
        { name "redundant" x 40  y 36  w 8  h 8 }
        { name "warning"   x 48  y 36  w 8  h 8 }
        { name "lock"      x 56  y 36  w 8  h 8 }
    ]
}

# The mod screen's words (`mod-management.md` §11). M opens it over the hall.
#
# Every one is here rather than in the source, for the card's reason: a translation is then a
# package, not a patch. The screen is built through the public table and reads these through
# it too, so it supplies only the shapes -- "3 installed", "...: lamps:kit" -- and a
# package can change any word without being able to crash it with a format string.
@schema screen {
    title string (default "")
    profile string (default "")
    profile_name string (default "")
    new string (default "")
    copy string (default "")
    rename string (default "")
    delete string (default "")
    close string (default "")
    filter string (default "")
    installed string (default "")
    enabled string (default "")
    problems string (default "")
    tab_details string (default "")
    tab_conflicts string (default "")
    tab_records string (default "")
    tab_problems string (default "")
    origin_installed string (default "")
    origin_user string (default "")
    environment string (default "")
    not_installed string (default "")
    version string (default "")
    requires string (default "")
    requirement_met string (default "")
    requirement_unmet string (default "")
    provides string (default "")
    records string (default "")
    wins string (default "")
    loses string (default "")
    loaded_now string (default "")
    yes string (default "")
    no string (default "")
    no_native string (default "")
    select_prompt string (default "")
    conflicts_none string (default "")
    conflict_won string (default "")
    conflict_lost string (default "")
    record_prompt string (default "")
    record_invalid string (default "")
    record_none string (default "")
    record_winner string (default "")
    problems_none string (default "")
    skip_not_installed string (default "")
    skip_missing_dependency string (default "")
    skip_dependency_version string (default "")
    skip_dependency_skipped string (default "")
    skip_cycle string (default "")
    skip_duplicate string (default "")
    skip_shadows_installed string (default "")
    unsaved string (default "")
    next_start string (default "")
    apply string (default "")
    revert string (default "")
    drop_into string (default "")
    up string (default "")
    down string (default "")
    top string (default "")
    bottom string (default "")
    profile_unusable string (default "")
}

screen room:screen.mods {
    title                   "Mods"
    profile                 "Profile"
    profile_name            "Name"
    new                     "New"
    copy                    "Copy"
    rename                  "Rename"
    delete                  "Delete"
    close                   "Close"
    filter                  "Filter"
    installed               "installed"
    enabled                 "on"
    problems                "problems"
    tab_details             "Details"
    tab_conflicts           "Conflicts"
    tab_records             "Records"
    tab_problems            "Problems"
    origin_installed        "built-in"
    origin_user             "yours"
    environment             "On for this session only."
    not_installed           "not installed"
    version                 "version"
    requires                "Requires"
    requirement_met         "ok"
    requirement_unmet       "missing"
    provides                "Provides"
    records                 "records"
    wins                    "wins"
    loses                   "loses"
    loaded_now              "Loaded now:"
    yes                     "yes"
    no                      "no"
    no_native               "This game does not load native code."
    select_prompt           "Select a mod to see it here."
    conflicts_none          "Nothing it provides is in dispute."
    conflict_won            "this mod wins"
    conflict_lost           "won by"
    record_prompt           "Record"
    record_invalid          "That is not a content id."
    record_none             "No package provides it."
    record_winner           "wins"
    problems_none           "Nothing is wrong."
    skip_not_installed      "is on your list but not installed"
    skip_missing_dependency "needs a package that is not here"
    skip_dependency_version "needs a different version of a package"
    skip_dependency_skipped "needs a package that cannot load"
    skip_cycle              "requires itself, through others"
    skip_duplicate          "shares its id with another of your mods; neither loads"
    skip_shadows_installed  "has the id of a built-in package, which loads instead"
    unsaved                 "Changes not applied yet."
    next_start              "change(s) take effect the next time the hall opens."
    apply                   "Apply"
    revert                  "Revert"
    drop_into               "Drop mods into"
    up                      "Up"
    down                    "Down"
    top                     "Top"
    bottom                  "Bottom"
    profile_unusable        "(cannot be used)"
}

# The window the hall opens in, and how loud it is, until a player says otherwise.
config room:config.main {
    window_width  1280
    window_height 720
    master_volume 0.8
    window_icon   room:icons.foundry
}

# An image a window wears: a kind of asset the engine does not define. The sample decodes it
# with a loader of its own, registered exactly as a mod's would be (I6), and lends the pixels
# to the window for one call. `source` is what makes a record an asset.
@schema icon { source string }

# Foundry's glyph, because the room is Foundry demonstrating itself (`brand/README.md`). A game
# supplies its own. 64x64, from the master by `sips -z 64 64`.
icon room:icons.foundry { source "icon.png" }

clip room:clip.walk {
    sheet   room:textures.room
    columns 4
    rows    4
    first   4
    count   4
    hold    7
}

# Standing still: the walk's first frame, held. One frame is a legal clip and means a still
# pose, which is why `count` has no lower bound worth writing down.
clip room:clip.idle {
    sheet   room:textures.room
    columns 4
    rows    4
    first   4
    count   1
    hold    30
}

clip room:clip.lamp.dark {
    sheet   room:textures.room
    columns 4
    rows    4
    first   8
    count   1
    hold    30
}

# Three frames of widening glow, slowly. A lit lamp has to be readable from the far end of
# the hall, which is what the halo in the sheet is for and what makes this a clip rather
# than a second still.
clip room:clip.lamp.lit {
    sheet   room:textures.room
    columns 4
    rows    4
    first   9
    count   3
    hold    14
}

clip room:clip.door {
    sheet   room:textures.room
    columns 4
    rows    4
    first   12
    count   1
    hold    30
}

# The map. Three engine-owned record types and one asset, none of them declared here.

foundry:tileset room:tiles.hall {
    texture room:textures.room
    tile    [ 16 16 ]
    columns 4
    # Only the wall blocks. The threshold and the rug are floor that looks different, which
    # is the point of keeping collision in the tileset rather than in the grid.
    solid   [ 1 ]
}

foundry:tilemap.layer room:map.hall.floor {
    tileset  room:tiles.hall
    grid     room:grids.hall
    # Beneath everything the sample draws, which all sits at 0 or above.
    order    -10
    collides true
}

foundry:tilemap room:map.hall {
    size   [ 32 24 ]
    cell   [ 16 16 ]
    layers [ room:map.hall.floor ]
}

# Six lamps, at the ends of the hall the walker has to go and find. Six records and no
# code: adding a seventh is an edit to this file, and so is moving one.

lamp room:lamp.north.west { at [  2 11 ] dark room:clip.lamp.dark lit room:clip.lamp.lit }
lamp room:lamp.north.east { at [ 29 11 ] dark room:clip.lamp.dark lit room:clip.lamp.lit }
lamp room:lamp.south.west { at [  2 18 ] dark room:clip.lamp.dark lit room:clip.lamp.lit }
lamp room:lamp.south.east { at [ 29 18 ] dark room:clip.lamp.dark lit room:clip.lamp.lit }
lamp room:lamp.north       { at [ 15  8 ] dark room:clip.lamp.dark lit room:clip.lamp.lit }
lamp room:lamp.south       { at [ 16 21 ] dark room:clip.lamp.dark lit room:clip.lamp.lit }

# The door, filling the two-cell gap in row 6.
door room:door.north {
    at   [ 15 6 ]
    span [ 2 1 ]
    clip room:clip.door
}

# The threshold beyond it.
way_out room:way.out {
    at   [ 14 2 ]
    span [ 4 2 ]
}

foundry:model_import court:models.court { source "models/court.gltf" collision true }
foundry:model_import court:models.beacon { source "models/beacon.gltf" }
foundry:model_import court:models.gate { source "models/gate.gltf" }
foundry:model_import court:models.warden { source "models/warden.gltf" }

@schema config {
    title string
    # Defaults a player's settings.fset may replace (ADR-0031).
    window_width u32 window_height u32
    master_volume f32
    look_sensitivity f32
    invert_look bool
    # How long the goal line stays on screen at the start of each game, seconds.
    goal_seconds f32
    clear_linear [f32]
    level id
    exposure_ev100 f32
    ambient { r f32 g f32 b f32 }
    lights [{
        kind string
        color { r f32 g f32 b f32 }
        intensity f32 range f32 (default 0)
        inner_cone f32 (default 0) outer_cone f32 (default 0.785398)
        casts_shadow bool (default false)
        position { x f32 y f32 z f32 }
        direction { x f32 y f32 z f32 }
    }]
}
config court:config.main {
    title "Foundry Court"
    window_width 1280 window_height 720
    master_volume 0.8
    look_sensitivity 1
    invert_look false
    goal_seconds 6
    clear_linear [ 0.004 0.006 0.014 1 ]
    level court:models.court
    exposure_ev100 4
    ambient { r 2 g 3 b 5 }
    lights [{ kind "directional" color { r 0.65 g 0.75 b 1 }
        intensity 70 casts_shadow true position { x 0 y 0 z 0 }
        direction { x -1 y -2 z -1 } }]
}

@schema rules {
    spawn { x f32 y f32 z f32 }
    spawn_yaw f32 (default 0)
    radius f32 height f32 eye_height f32
    max_slope f32 step_height f32 snap_distance f32
    walk_speed f32 gravity f32 jump_speed f32 turn_rate f32 look_rate f32
    collision [id]
    reach f32
    catch_distance f32
    pit_height f32
    exit_min { x f32 y f32 z f32 }
    exit_max { x f32 y f32 z f32 }
}
rules court:rules.main {
    spawn { x 0 y 0.004 z 5 }
    radius 0.3 height 1.8 eye_height 1.65
    max_slope 0.785398 step_height 0.25 snap_distance 0.2
    walk_speed 3 gravity 9.81 jump_speed 5 turn_rate 1.5 look_rate 0.004
    collision [ court:models.court.collision ]
    reach 2.5
    catch_distance 1.2
    pit_height -2.0
    exit_min { x -1.2 y -0.5 z -9.5 }
    exit_max { x 1.2 y 2.5 z -8.0 }
}

# A beacon is lit by a Use ray against `use_half`, a box standing on `position`.
@schema beacon {
    model id
    sound id
    position { x f32 y f32 z f32 }
    use_half { x f32 y f32 z f32 }
    light {
        color { r f32 g f32 b f32 }
        intensity f32
        range f32
        height f32
    }
}
beacon court:beacon.open {
    model court:models.beacon
    sound court:sounds.beacon
    position { x 3.5 y 0 z 4.5 }
    use_half { x 0.4 y 0.5 z 0.4 }
    light { color { r 1 g 0.65 b 0.3 } intensity 150 range 6 height 1 }
}
beacon court:beacon.wall {
    model court:models.beacon
    sound court:sounds.beacon
    position { x -3 y 0 z -0.5 }
    use_half { x 0.4 y 0.5 z 0.4 }
    light { color { r 1 g 0.65 b 0.3 } intensity 150 range 6 height 1 }
}
beacon court:beacon.ledge {
    model court:models.beacon
    sound court:sounds.beacon
    position { x 2 y 0 z -5.5 }
    use_half { x 0.4 y 0.5 z 0.4 }
    light { color { r 1 g 0.65 b 0.3 } intensity 150 range 6 height 1 }
}

# The gate sinks into the ground, so it never moves into a character (ADR-0051).
@schema gate {
    model id
    half_extents { x f32 y f32 z f32 }
    closed { x f32 y f32 z f32 }
    open { x f32 y f32 z f32 }
    travel_time f32
}
gate court:gate.main {
    model court:models.gate
    half_extents { x 1 y 1.25 z 0.08 }
    closed { x 0 y 1.25 z -7.7 }
    open { x 0 y -1.4 z -7.7 }
    travel_time 1.5
}

# `pause` is the seconds the warden stands at each waypoint.
@schema warden {
    model id
    waypoints [{ x f32 y f32 z f32 }]
    speed f32
    cross_fade f32
    radius f32
    height f32
    pause f32
}
warden court:warden.main {
    model court:models.warden
    waypoints [ { x -2 y 0.004 z 2.5 } { x 2 y 0.004 z 2.5 } ]
    speed 1.0
    cross_fade 0.25
    radius 0.22
    height 1.7
    pause 1
}

# What the court sounds like (playable3d.md §6.2). The .wav files become `foundry:sound`
# records from their paths; this names which one each event plays. Distances are metres.
@schema sound_set {
    ambience id  ambience_gain f32
    step id  step_distance f32
    jump id  land id
    gate id
    warden_step id  warden_step_distance f32
    # A positioned sound is silent at this distance and full at none.
    hearing_distance f32
    won id  caught id  fell id
    click id
}
sound_set court:sounds.main {
    ambience court:sounds.ambience  ambience_gain 0.35
    step court:sounds.step  step_distance 1.6
    jump court:sounds.jump  land court:sounds.land
    gate court:sounds.gate
    warden_step court:sounds.warden_step  warden_step_distance 0.9
    hearing_distance 14
    won court:sounds.won  caught court:sounds.caught  fell court:sounds.fell
    click court:sounds.click
}

# Every string the court shows. A translation overrides this one record.
@schema text {
    title string  goal string  goal_detail string  controls string
    play string  options string  quit string
    paused string  resume string  restart string  to_title string  pointer_released string
    won string  won_detail string  caught string  caught_detail string  fell string  fell_detail string
    beacons_lit string  objective string  objective_gate string  pause_hint string
    use_key string  use_prompt string
    menu_hints string  options_hints string
    audio string  master_volume string
    controls_section string  look_sensitivity string  invert_look string  on string  off string
    applies_at_once string  back string
    no_gate string
}
text court:text.main {
    title "The Court"
    goal "Light the three beacons. The gate opens when all three burn."
    goal_detail "Walk through the gate to leave. Keep clear of the warden, and of the gap."
    controls "WASD move   Mouse look   Space jump   E light a beacon   Esc pause"
    play "Play"  options "Options"  quit "Quit"
    paused "Paused"  resume "Resume"  restart "Restart"  to_title "Quit to title"
    pointer_released "Pointer released while paused."
    won "You left the court."  won_detail "All three beacons burn and the gate stands open."
    caught "The warden caught you."  caught_detail "It walks the same patrol every time. Go around it."
    fell "You fell into the gap."  fell_detail "The ledge is a jump away, not a step."
    beacons_lit "Beacons lit"
    objective "Light the three beacons"  objective_gate "The gate is open. Walk through it."
    pause_hint "Esc  Pause"
    use_key "E"  use_prompt "Light the beacon"
    menu_hints "Up/Down  Choose     Enter  Select     Esc  Back"
    options_hints "Up/Down  Choose     Left/Right  Change     Esc  Back"
    audio "Audio"  master_volume "Master volume"
    controls_section "Controls"  look_sensitivity "Look sensitivity"  invert_look "Invert look"
    on "On"  off "Off"
    applies_at_once "Changes apply at once and are saved."
    back "Back"
    no_gate "This court has no gate and cannot be finished."
}

# How the court's screens look (ADR-0041): near-black surfaces, hairlines, one mint accent.
# `textures/ui.png` is drawn by scripts/m26/make_court.py. Colours are sRGB, 0xRRGGBBAA.
foundry:ui_theme court:ui.theme {
    atlas       court:textures.ui
    font        { texture foundry:fonts.debug  cell_w 8  cell_h 8  columns 16  count 95 }
    text_scale  2
    line_height 34
    padding_x   14
    padding_y   8
    spacing     6
    separator   1
    patch_scale 1
    colors {
        text     0xf4f4f5ff   text_dim    0x9a9aa2ff   surface        0x0b0b0ce6
        control  0x1c1c20ff   control_hot 0x26262cff   control_active 0x7ee2b8ff
        accent   0x7ee2b8ff
        positive 0x7ee2b8ff   negative    0xf08a7bff   warning        0xf0c050ff
        selection 0x7ee2b8ff
    }
    patches [
        { part "panel"           x 0   y 0   w 12  h 12  left 4  top 4  right 4  bottom 4 }
        { part "button"          x 12  y 0   w 12  h 12  left 4  top 4  right 4  bottom 4 }
        { part "button_hot"      x 24  y 0   w 12  h 12  left 4  top 4  right 4  bottom 4 }
        { part "button_active"   x 36  y 0   w 12  h 12  left 4  top 4  right 4  bottom 4 }
        { part "button_disabled" x 48  y 0   w 12  h 12  left 4  top 4  right 4  bottom 4 }
        { part "field"           x 0   y 12  w 12  h 12  left 4  top 4  right 4  bottom 4 }
        { part "check_off"       x 12  y 12  w 12  h 12  left 4  top 4  right 4  bottom 4 }
        { part "check_on"        x 24  y 12  w 12  h 12  left 4  top 4  right 4  bottom 4 }
        { part "row"             x 36  y 12  w 12  h 12  left 4  top 4  right 4  bottom 4 }
        { part "row_selected"    x 48  y 12  w 12  h 12  left 4  top 4  right 4  bottom 4 }
        { part "tab"             x 0   y 24  w 12  h 12  left 4  top 4  right 4  bottom 4 }
        { part "tab_on"          x 12  y 24  w 12  h 12  left 4  top 4  right 4  bottom 4 }
        { part "scroll_track"    x 24  y 24  w 12  h 12  left 4  top 4  right 4  bottom 4 }
        { part "scroll_thumb"    x 36  y 24  w 12  h 12  left 4  top 4  right 4  bottom 4 }
    ]
    icons [
        { name "reticle" x 1  y 37  w 6  h 6 }
    ]
}

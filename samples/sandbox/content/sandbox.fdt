# The sandbox's own content package.
#
# A game defines its own schemas and ships its own package; this is the smallest honest
# example of that. It loads after `foundry:core` (package zero), through the same call,
# with no privileged path either way — which is I3 seen from the consumer's side.
#
# Everything the sample would otherwise have written as a Zig constant lives here, so
# changing what it draws is a content edit rather than a rebuild — and a package placed
# after this one can override `sandbox:settings.main` and change it again without touching
# either.

@schema settings {
    # How many sprites the field holds. The number M2 exists to make interesting.
    sprites u32 (default 4000)
    # The sprite sheet is a square grid; this is its side, in cells.
    grid u32 (default 4)
    # Drawn in world space at the origin, so the camera moves relative to it.
    banner string (default "")
    # Which assets to draw with, by content id. The sample names no paths and no files:
    # it asks for these two ids and the asset registry answers (ADR-0021).
    sheet id
    # From `foundry:core`, not from here. A cross-package reference is an ordinary id.
    font id
    # The map drawn under the field. Where it *goes* is the sample's decision, not this
    # record's: a `foundry:tilemap` says how big a map is, never where it sits.
    map id
    # The driven thing: how wide its box is, in world units, and how fast it walks, in
    # world units per second. Both are *feel*, and feel is the game's -- which is why
    # `physics2d` has no speed anywhere in it (ADR-0022: collision, not dynamics).
    player_size  f32 (default 12)
    player_speed f32 (default 84)
}

settings sandbox:settings.main {
    sprites 4000
    grid    4
    banner  "foundry sandbox\nworld origin"
    sheet   sandbox:textures.sprites
    font    foundry:fonts.debug
    map     sandbox:map.room
    # Narrower than the 16-unit cells, so a one-cell gap is a gap the player fits through.
    player_size  12
    player_speed 84
}

# The sample's map. Three engine-owned record types and one asset, none of them declared
# here: `foundry:tileset`, `foundry:tilemap.layer` and `foundry:tilemap` are registered
# before this file is compiled, exactly as `foundry:texture` is.

foundry:tileset sandbox:tiles.room {
    # The same sheet the sprites use, read as a 4x4 grid of 16-pixel tiles.
    texture sandbox:textures.sprites
    tile    [ 16 16 ]
    columns 4
    # Which tile ids block. Everything else is floor. This one list is the whole of the
    # map's collision, and a mod can change it without touching the map.
    solid   [ 1 ]
}

foundry:tilemap.layer sandbox:map.room.walls {
    tileset  sandbox:tiles.room
    grid     sandbox:grids.room
    # Beneath the sprite field, which draws at 0. One number, in content, and no code in
    # the sample decides what is on top of what.
    order    -10
    collides true
}

foundry:tilemap sandbox:map.room {
    size   [ 12 10 ]
    cell   [ 16 16 ]
    layers [ sandbox:map.room.walls ]
}

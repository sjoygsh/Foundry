# The sandbox's own content package.
#
# A game defines its own schemas and ships its own package; this is the smallest honest
# example of that. It loads after `foundry:core` (package zero), through the same call,
# with no privileged path either way — which is I3 seen from the consumer's side.
#
# Everything the sample would otherwise have written as a Zig constant lives here, so
# changing what it draws is a content edit rather than a rebuild — and a package placed
# after this one can override `sandbox:settings.main` and change it again without touching
# either.

@schema settings {
    # How many sprites the field holds. The number M2 exists to make interesting.
    sprites u32 (default 4000)
    # The sprite sheet is a square grid; this is its side, in cells.
    grid u32 (default 4)
    # Drawn in world space at the origin, so the camera moves relative to it.
    banner string (default "")
    # Which assets to draw with, by content id. The sample names no paths and no files:
    # it asks for these two ids and the asset registry answers (ADR-0021).
    sheet id
    # From `foundry:core`, not from here. A cross-package reference is an ordinary id.
    font id
    # The map drawn under the field. Where it *goes* is the sample's decision, not this
    # record's: a `foundry:tilemap` says how big a map is, never where it sits.
    map id
    # The driven thing: how wide its box is, in world units, and how fast it walks, in
    # world units per second. Both are *feel*, and feel is the game's -- which is why
    # `physics2d` has no speed anywhere in it (ADR-0022: collision, not dynamics).
    player_size  f32 (default 12)
    player_speed f32 (default 84)
    # Which clips play. The *choice* is content too, not just the clips: a package after
    # this one can point the player at a different animation without any code knowing.
    player_walk id
    player_idle id
    # What the four thousand play. One clip shared by all of them, each at its own phase,
    # because the phase is per-entity state and the clip is not.
    field_clip  id
    # The sounds. Three ids and no gains: what a mix bus is and where its slider lives is
    # deliberately still an open question (`audio.md` §11), and a per-sound gain field
    # here would be answering it by accident.
    step_sound id
    bump_sound id
    hum_sound  id
}

settings sandbox:settings.main {
    sprites 4000
    grid    4
    banner  "foundry sandbox\nworld origin"
    sheet   sandbox:textures.sprites
    font    foundry:fonts.debug
    map     sandbox:map.room
    # Narrower than the 16-unit cells, so a one-cell gap is a gap the player fits through.
    player_size  12
    player_speed 84
    player_walk  sandbox:clip.walk
    player_idle  sandbox:clip.idle
    field_clip   sandbox:clip.drift
    # **No records declare these.** A `.wav` in the package becomes a `foundry:sound` from
    # its own path, exactly as a `.png` becomes a `foundry:texture` — `sounds/step.wav` in
    # package `sandbox` is `sandbox:sounds.step`. Naming them here is the only place the
    # sample says anything about them at all.
    step_sound   sandbox:sounds.step
    bump_sound   sandbox:sounds.bump
    hum_sound    sandbox:sounds.hum
}

# An animation clip: a run of cells from a sheet, and how long each is held.
#
# **The engine defines no `foundry:clip`, deliberately** — M5 adds no engine-owned schemas
# for the same reason it adds no `foundry:collider` (`sprite-animation.md` §5). A schema
# name is a compatibility decision, M7 is when the mod-facing vocabulary gets chosen, and
# nothing in the engine reads a clip: `render2d.frameAt` takes four integers and never
# learns where they came from. So this is the sample's, and it is also the reference for
# what an engine-owned one would look like.
@schema clip {
    # Where the frames live. A content id, never a path (ADR-0021).
    sheet id
    # The sheet is a grid; these are its dimensions in cells.
    columns u32
    rows    u32
    # The run of cells this clip plays, row-major from `first`.
    first u32 (default 0)
    count u32
    # Ticks each frame is held. At 60 Hz, 6 is a ten-frames-per-second animation.
    hold u32 (default 6)
    # Whether it wraps or pins to its last frame.
    loops bool (default true)
}

# The sheet is a 4x4 grid where a row is one colour in four shapes, so a row is a clip.

clip sandbox:clip.walk {
    sheet   sandbox:textures.sprites
    columns 4
    rows    4
    first   4
    count   4
    hold    6
}

# Standing still: the walk's first frame, held. One frame is a legal clip and means a
# still pose, which is why `count` has no lower bound worth writing down.
clip sandbox:clip.idle {
    sheet   sandbox:textures.sprites
    columns 4
    rows    4
    first   4
    count   1
    hold    30
}

# The field's, which runs the whole sheet. Every sprite plays this one at its own phase.
clip sandbox:clip.drift {
    sheet   sandbox:textures.sprites
    columns 4
    rows    4
    first   0
    count   16
    hold    12
}

# The sample's map. Three engine-owned record types and one asset, none of them declared
# here: `foundry:tileset`, `foundry:tilemap.layer` and `foundry:tilemap` are registered
# before this file is compiled, exactly as `foundry:texture` is.

foundry:tileset sandbox:tiles.room {
    # The same sheet the sprites use, read as a 4x4 grid of 16-pixel tiles.
    texture sandbox:textures.sprites
    tile    [ 16 16 ]
    columns 4
    # Which tile ids block. Everything else is floor. This one list is the whole of the
    # map's collision, and a mod can change it without touching the map.
    solid   [ 1 ]
}

foundry:tilemap.layer sandbox:map.room.walls {
    tileset  sandbox:tiles.room
    grid     sandbox:grids.room
    # Beneath the sprite field, which draws at 0. One number, in content, and no code in
    # the sample decides what is on top of what.
    order    -10
    collides true
}

foundry:tilemap sandbox:map.room {
    size   [ 12 10 ]
    cell   [ 16 16 ]
    layers [ sandbox:map.room.walls ]
}

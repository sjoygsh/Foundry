{
  "name": "Foundry content (.fdt)",
  "scopeName": "source.fdt",
  "fileTypes": ["fdt"],
  "comment": "Foundry's authoring format (ADR-0020, content-schemas.md §4). Kept beside data/lexer.zig, whose tests check it names every token the lexer makes. Installed as share/foundry/fdt.tmLanguage.json.",
  "patterns": [
    { "include": "#comment" },
    { "include": "#string" },
    { "include": "#directive" },
    { "include": "#number" },
    { "include": "#content-id" },
    { "include": "#constant" },
    { "include": "#type" },
    { "include": "#identifier" },
    { "include": "#brackets" }
  ],
  "repository": {
    "comment": {
      "name": "comment.line.number-sign.fdt",
      "match": "#.*$"
    },
    "string": {
      "name": "string.quoted.double.fdt",
      "begin": "\"",
      "end": "\"|$",
      "patterns": [{ "name": "constant.character.escape.fdt", "match": "\\\\." }]
    },
    "directive": {
      "name": "keyword.control.directive.fdt",
      "match": "@[A-Za-z0-9_.:-]+"
    },
    "number": {
      "name": "constant.numeric.fdt",
      "match": "(?<![A-Za-z0-9_.:-])-?(?:0x[0-9A-Fa-f_]+|[0-9][0-9_]*(?:\\.[0-9_]+)?(?:[eE][+-]?[0-9_]+)?)(?![A-Za-z0-9_.:-])"
    },
    "content-id": {
      "name": "entity.name.tag.content-id.fdt",
      "match": "[A-Za-z0-9_.-]*:[A-Za-z0-9_.:-]*"
    },
    "constant": {
      "name": "constant.language.fdt",
      "match": "(?<![A-Za-z0-9_.:-])(?:true|false)(?![A-Za-z0-9_.:-])"
    },
    "type": {
      "name": "storage.type.fdt",
      "match": "(?<![A-Za-z0-9_.:-])(?:bool|i32|i64|u32|u64|f32|f64|string|id)(?![A-Za-z0-9_.:-])"
    },
    "identifier": {
      "name": "variable.other.field.fdt",
      "match": "[A-Za-z0-9_.-]+"
    },
    "brackets": {
      "name": "punctuation.section.fdt",
      "match": "[{}\\[\\]()]"
    }
  }
}

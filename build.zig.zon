.{
    .name = .foundry,
    .version = "0.0.0",
    // Globally unique package identity. Generated once, then never changed.
    .fingerprint = 0x1d6d45b13ea75e55, // Changing this has security and trust implications.
    .minimum_zig_version = "0.16.0",

    .dependencies = .{
        // Mbed TLS is the pinned transport-security provider qualified in M16
        // Step 1. The 3.6 LTS tag snapshot contains the generated C sources
        // needed by a Zig-only build; the unused test-framework submodule is
        // deliberately absent. It is compiled directly by build.zig, never by
        // CMake or Make (ADR-0045).
        // License entry: THIRD_PARTY_LICENSES/mbedtls.md (Apache-2.0 elected)
        .mbedtls = .{
            .url = "https://codeload.github.com/Mbed-TLS/mbedtls/tar.gz/refs/tags/v3.6.7",
            .hash = "N-V-__8AALrvlQKVtYlvv9dpBnbrJfdwR_F0wAgwsvZhAF1Y",
        },
        // PUC Lua, embedded by the optional M8 L6 scripting test module. The
        // interpreter is compiled directly from this exact upstream archive;
        // no Lua build script or system installation is used (ADR-0028).
        // License entry: THIRD_PARTY_LICENSES/lua.md (MIT)
        .lua = .{
            .url = "https://www.lua.org/ftp/lua-5.5.1.tar.gz",
            .hash = "N-V-__8AAPqeFQDipy0CdI6MKBmwYYarybBTO3IIJPrSzH_w",
            .lazy = true,
        },
        // SDL3, via its Zig build-system port. Confined to the `platform` module
        // (ADR-0002); nothing above L1 may reference it, and `rhi` never sees an SDL
        // type — it gets an opaque NativeSurfaceHandle instead.
        //
        // Marked lazy, but note what that does and does not do in Zig 0.16: the
        // package is still extracted into `zig-pkg/` on any build, whether or not
        // `platform` is reached. `lazy` governs how build.zig must ask for it
        // (`b.lazyDependency`, which may return null), not whether it is materialised.
        // The cost is a local extraction from the global cache, not a download.
        //
        // License entry: THIRD_PARTY_LICENSES/sdl3.md (zlib; HIDAPI elected BSD-3-Clause)
        .sdl = .{
            .url = "git+https://github.com/castholm/SDL.git?ref=v0.5.3+3.4.14#fb2d799c4778832a34ccb3739e40dded700684bd",
            .hash = "sdl-0.5.3+3.4.14-SDL--v4eqAGuIKFsspMVxBxZf1OIEmmH-yHDdEl9ZRdX",
            .lazy = true,
        },
        // Khronos Vulkan C headers for M13's Vulkan backend, included only by `rhi`
        // with VK_NO_PROTOTYPES (ADR-0038). The tag matches the pinned Vulkan SDK
        // 1.4.357.0. Lazy: null and Metal builds never ask for it, and a checkout whose
        // global cache lacks it neither downloads nor extracts it (checked 2026-09-14).
        // License entry: THIRD_PARTY_LICENSES/vulkan-headers.md (Apache-2.0 elected)
        .vulkan_headers = .{
            .url = "https://github.com/KhronosGroup/Vulkan-Headers/archive/refs/tags/v1.4.357.tar.gz",
            .hash = "N-V-__8AAO2WewIbm0OeFBxoD5LxmEzZigF1yXmgGLuahMD5",
            .lazy = true,
        },
    },

    // Everything `build.zig` reaches, because a game that depends on Foundry by URL runs this
    // build script against exactly these files and nothing else. `tools` holds
    // `foundry.release` and the compilers; the samples and the editor are declared steps even
    // when nobody runs them; `content/core` is package zero; and the license entries are the
    // attribution a game's release must carry for Foundry's own dependencies.
    .paths = .{
        "build.zig",
        "build.zig.zon",
        "engine",
        "tools",
        "samples",
        "content",
        "brand",
        "THIRD_PARTY_LICENSES",
        "LICENSE",
        "NOTICE",
        "README.md",
    },
}
